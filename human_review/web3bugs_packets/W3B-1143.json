)\n   385 |     {\n   386 |         (DataTypes.Vault memory vault_, DataTypes.Series memory oldSeries_, DataTypes.Balances memory balances_) = vaultData(vaultId, true);\n   387 |         DataTypes.Series memory newSeries_ = series[newSeriesId];\n   388 |         require (oldSeries_.baseId == newSeries_.baseId, \"Mismatched bases in series\");\n   389 |         \n   390 |         // Change the vault series\n   391 |         vault_.seriesId = newSeriesId;\n   392 |         _tweak(vaultId, vault_);\n   393 | \n   394 |         // Change the vault balances\n   395 |         balances_ = _pour(vaultId, vault_, balances_, newSeries_, 0, art);","start_line":379,"status":"AVAILABLE"},{"end_line":271,"file":"contracts/Cauldron.sol","line":263,"resolved_path":"contracts/Cauldron.sol","source":"   255 | \n   256 |     function vaultData(bytes12 vaultId, bool getSeries)\n   257 |         internal\n   258 |         view\n   259 |         returns (DataTypes.Vault memory vault_, DataTypes.Series memory series_, DataTypes.Balances memory balances_)\n   260 |     {\n   261 |         vault_ = vaults[vaultId];\n   262 |         require (vault_.seriesId != bytes6(0), \"Vault not found\");\n   263 |         if (getSeries) series_ = series[vault_.seriesId];\n   264 |         balances_ = balances[vaultId];\n   265 |     }\n   266 | \n   267 |     /// @dev Move collateral and debt between vaults.\n   268 |     function stir(bytes12 from, bytes12 to, uint128 ink, uint128 art)\n   269 |         external\n   270 |         auth\n   271 |         returns (DataTypes.Balances memory, DataTypes.Balances memory)","start_line":255,"status":"AVAILABLE"}],"structural_claim":{"dataset":"web3bugs","key_equality_constraints":[],"origin_sites":[{"block_id":["contracts/Cauldron.sol::Cauldron.roll(bytes12,bytes6,int128)",6],"expression":"require(bool,string)(oldSeries_.baseId == newSeries_.baseId,Mismatched bases in series)","function_key":"contracts/Cauldron.sol::Cauldron.roll(bytes12,bytes6,int128)"}],"pot